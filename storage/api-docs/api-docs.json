{
    "openapi": "3.0.0",
    "info": {
        "title": "Laravel API Documentation",
        "description": "API Documentation for the Authentication module",
        "contact": {
            "email": "admin@example.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login user and create token",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Login successful"
                                        },
                                        "access_token": {
                                            "type": "string",
                                            "example": "1|XYZ..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid login credentials"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout user (Revoke the token)",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Logged out successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logged out successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/forgot-password": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Send password reset link",
                "operationId": "20d78161b19ac6afb56924e74974ec46",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset link sent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "passwords.sent"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid email or user not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/ebay/listings/by-sku": {
            "get": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Get eBay listings for a SKU using Inventory API",
                "operationId": "d4fe8baca2523de8098aee8c08516082",
                "parameters": [
                    {
                        "name": "sku",
                        "in": "query",
                        "description": "The SKU value to retrieve listings for",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "eBay listings retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "sku": {
                                            "type": "string",
                                            "example": "ABC123"
                                        },
                                        "count": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "sku": {
                                                        "type": "string",
                                                        "example": "ABC123"
                                                    },
                                                    "offer_id": {
                                                        "type": "string",
                                                        "example": "123456789"
                                                    },
                                                    "listing_id": {
                                                        "type": "string",
                                                        "example": "987654321"
                                                    },
                                                    "listing_status": {
                                                        "type": "string",
                                                        "example": "ACTIVE"
                                                    },
                                                    "marketplace_id": {
                                                        "type": "string",
                                                        "example": "EBAY_US"
                                                    },
                                                    "format": {
                                                        "type": "string",
                                                        "example": "FIXED_PRICE"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "eBay API Error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Fetch eBay listing data by SKUs",
                "operationId": "5e149099aad7c6a245890f46904c433d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "skus"
                                ],
                                "properties": {
                                    "skus": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "ST101"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Listings fetched successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/ebay/listings/by-item-id": {
            "post": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Fetch eBay listing data by Item IDs",
                "operationId": "d9ec29a8b6b5fa309e1536559728bd34",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "item_ids"
                                ],
                                "properties": {
                                    "item_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "270646159307"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Listings fetched successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/ebay/listings/item-ids-by-custom-label": {
            "get": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Find eBay Item IDs by Custom label (SKU)",
                "description": "Returns Item IDs whose Custom label (eBay SKU field) matches the provided SKU. Uses a direct GetItem lookup and a filtered GetSellerList query (not a full-catalog scan).",
                "operationId": "24bcd0a9156d8e417c4db6691a500ff1",
                "parameters": [
                    {
                        "name": "sku",
                        "in": "query",
                        "description": "Custom label / SKU value to search for",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "ST101"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Item IDs found for the given Custom label",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "sku": {
                                            "type": "string",
                                            "example": "ST101"
                                        },
                                        "count": {
                                            "type": "integer",
                                            "example": 2
                                        },
                                        "item_ids": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "example": [
                                                "270646159307",
                                                "270646159308"
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "eBay API Error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/generate-ebay-fitment-csv": {
            "post": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Generate eBay Motors fitment CSV file",
                "operationId": "fb7ea421fe1e29f9fdb8867946bbcd85",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "item_number",
                                    "fitment_rows",
                                    "ebay_item_ids"
                                ],
                                "properties": {
                                    "item_number": {
                                        "type": "string",
                                        "example": "123456789012"
                                    },
                                    "fitment_rows": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "relationship": {
                                                    "type": "string",
                                                    "example": "Compatibility"
                                                },
                                                "relationship_details": {
                                                    "type": "string",
                                                    "example": "Make=Yamaha|Model=Big Bear 350|Year=1998|Submodel=YFM350FW 4x4"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "ebay_item_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "270646159307"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "CSV file generated successfully",
                        "content": {
                            "text/csv": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Login with email and password to get the authentication token",
                "name": "Token based Based",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "eBay Listings",
            "description": "eBay Listings"
        }
    ]
}