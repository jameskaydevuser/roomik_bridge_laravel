{
    "openapi": "3.0.0",
    "info": {
        "title": "Laravel API Documentation",
        "description": "API Documentation for the Authentication module",
        "contact": {
            "email": "admin@example.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login user and create token",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Login successful"
                                        },
                                        "access_token": {
                                            "type": "string",
                                            "example": "1|XYZ..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid login credentials"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout user (Revoke the token)",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Logged out successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logged out successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/forgot-password": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Send password reset link",
                "operationId": "20d78161b19ac6afb56924e74974ec46",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset link sent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "passwords.sent"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid email or user not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/ebay/listings/{itemId}/feedback": {
            "get": {
                "tags": [
                    "eBay Feedback"
                ],
                "summary": "Get feedback for an eBay item",
                "operationId": "57c18da162cc43ce74cea41ed66972a4",
                "parameters": [
                    {
                        "name": "itemId",
                        "in": "path",
                        "description": "The eBay Item ID",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "comment_text",
                        "in": "query",
                        "description": "Partial search in comment text",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "comment_time_from",
                        "in": "query",
                        "description": "Filter feedback date/time from",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "comment_time_to",
                        "in": "query",
                        "description": "Filter feedback date/time to",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "comment_type",
                        "in": "query",
                        "description": "Exact match for comment type",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "Positive",
                                "Neutral",
                                "Negative"
                            ]
                        }
                    },
                    {
                        "name": "role",
                        "in": "query",
                        "description": "Exact match for role",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "Buyer",
                                "Seller"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "eBay feedback retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "current_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "ebay_item_id": {
                                                        "type": "string",
                                                        "example": "270646159307"
                                                    },
                                                    "feedback_id": {
                                                        "type": "string",
                                                        "example": "1029384756"
                                                    },
                                                    "commenting_user": {
                                                        "type": "string",
                                                        "example": "buyer_user"
                                                    },
                                                    "commenting_user_score": {
                                                        "type": "integer",
                                                        "example": 120
                                                    },
                                                    "comment_text": {
                                                        "type": "string",
                                                        "example": "Great seller, fast shipping!"
                                                    },
                                                    "comment_time": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2026-07-02T12:00:00Z"
                                                    },
                                                    "comment_type": {
                                                        "type": "string",
                                                        "example": "Positive"
                                                    },
                                                    "role": {
                                                        "type": "string",
                                                        "example": "Buyer"
                                                    },
                                                    "transaction_id": {
                                                        "type": "string",
                                                        "example": "9876543210"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2026-07-02T15:00:00Z"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2026-07-02T15:00:00Z"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "first_page_url": {
                                            "type": "string",
                                            "example": "http://localhost:8000/api/ebay/listings/270646159307/feedback?page=1"
                                        },
                                        "from": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "last_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "last_page_url": {
                                            "type": "string",
                                            "example": "http://localhost:8000/api/ebay/listings/270646159307/feedback?page=1"
                                        },
                                        "links": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "next_page_url": {
                                            "type": "string",
                                            "example": null,
                                            "nullable": true
                                        },
                                        "path": {
                                            "type": "string",
                                            "example": "http://localhost:8000/api/ebay/listings/270646159307/feedback"
                                        },
                                        "per_page": {
                                            "type": "integer",
                                            "example": 15
                                        },
                                        "prev_page_url": {
                                            "type": "string",
                                            "example": null,
                                            "nullable": true
                                        },
                                        "to": {
                                            "type": "integer",
                                            "example": 15
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 1
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "Server or eBay API error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/ebay/listings/{itemId}/feedback/export": {
            "get": {
                "tags": [
                    "eBay Feedback"
                ],
                "summary": "Export feedback for an eBay item as a CSV file",
                "operationId": "874809e435e0ab111004778d0a86efec",
                "parameters": [
                    {
                        "name": "itemId",
                        "in": "path",
                        "description": "The eBay Item ID",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "comment_text",
                        "in": "query",
                        "description": "Partial search in comment text",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "comment_time_from",
                        "in": "query",
                        "description": "Filter feedback date/time from",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "comment_time_to",
                        "in": "query",
                        "description": "Filter feedback date/time to",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "comment_type",
                        "in": "query",
                        "description": "Exact match for comment type",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "Positive",
                                "Neutral",
                                "Negative"
                            ]
                        }
                    },
                    {
                        "name": "role",
                        "in": "query",
                        "description": "Exact match for role",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "Buyer",
                                "Seller"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "CSV file containing eBay feedback exported successfully",
                        "content": {
                            "text/csv": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "Server or eBay API error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/ebay/listings/by-sku": {
            "get": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Get eBay listings for a SKU using Inventory API",
                "operationId": "d4fe8baca2523de8098aee8c08516082",
                "parameters": [
                    {
                        "name": "sku",
                        "in": "query",
                        "description": "The SKU value to retrieve listings for",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "eBay listings retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "sku": {
                                            "type": "string",
                                            "example": "ABC123"
                                        },
                                        "count": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "sku": {
                                                        "type": "string",
                                                        "example": "ABC123"
                                                    },
                                                    "offer_id": {
                                                        "type": "string",
                                                        "example": "123456789"
                                                    },
                                                    "listing_id": {
                                                        "type": "string",
                                                        "example": "987654321"
                                                    },
                                                    "listing_status": {
                                                        "type": "string",
                                                        "example": "ACTIVE"
                                                    },
                                                    "marketplace_id": {
                                                        "type": "string",
                                                        "example": "EBAY_US"
                                                    },
                                                    "format": {
                                                        "type": "string",
                                                        "example": "FIXED_PRICE"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "eBay API Error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Fetch eBay listing data by SKUs",
                "operationId": "5e149099aad7c6a245890f46904c433d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "skus"
                                ],
                                "properties": {
                                    "skus": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "ST101"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Listings fetched successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/generate-ebay-fitment-csv": {
            "post": {
                "tags": [
                    "eBay Listings"
                ],
                "summary": "Generate eBay Motors fitment CSV file",
                "operationId": "fb7ea421fe1e29f9fdb8867946bbcd85",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "item_number",
                                    "fitment_rows",
                                    "ebay_item_ids"
                                ],
                                "properties": {
                                    "item_number": {
                                        "type": "string",
                                        "example": "123456789012"
                                    },
                                    "fitment_rows": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "relationship": {
                                                    "type": "string",
                                                    "example": "Compatibility"
                                                },
                                                "relationship_details": {
                                                    "type": "string",
                                                    "example": "Make=Yamaha|Model=Big Bear 350|Year=1998|Submodel=YFM350FW 4x4"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "ebay_item_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "270646159307"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "CSV file generated successfully",
                        "content": {
                            "text/csv": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Login with email and password to get the authentication token",
                "name": "Token based Based",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
